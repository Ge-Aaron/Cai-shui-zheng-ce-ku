# ============================================================
#  财税政策库 · 云端部署环境变量模板
#  使用方法：
#    - 本地：复制为 .env 并填入真实值
#    - 云端（Render/Railway）：在平台控制台按下面 key 填入，不要把真实 key 提交到仓库
#  ⚠️ 本文件不含任何真实密钥，可安全提交。
# ============================================================

# ---------- AI 接入（OpenAI 兼容接口）----------
# 硅基流动 SiliconFlow（免费额度，可免费用 DeepSeek-V3 / Qwen2.5 等）
TAXDB_LLM_KEY=<在此填入你的硅基流动API密钥>
TAXDB_LLM_URL=https://api.siliconflow.cn/v1
TAXDB_LLM_MODEL=deepseek-ai/DeepSeek-V3

# 语义向量检索（RAG）嵌入模型（中文语义，1024 维）
TAXDB_EMBED_MODEL=BAAI/bge-m3

# 强制 JSON 结构化输出（AI 方案生成依赖此模式）
TAXDB_LLM_FEATURES=json

# 调试开关：设为 1 时使用内置 mock 演示（无需真实密钥）
TAXDB_LLM_MOCK=0

# ---------- 部署相关（通常无需修改）----------
# TAXDB_PORT 仅本地使用；云端由平自动注入 $PORT
# TAXDB_BIND 云端默认 0.0.0.0，本地可改 127.0.0.1
# TAXDB_NO_BROWSER=1 云端跳过自动打开浏览器
